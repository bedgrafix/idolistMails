<mjml>
	<mj-head>
		<mj-title>idolist application accept</mj-title>
		<mj-preview>idolist application accept</mj-preview>
		<mj-font name="Oswald" href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" />
		<mj-style>
			body {
			color: #1D1D1B;
			font-family: "Oswald", Arial, sans-serif;
			max-width: 480px;
			margin: 0 auto;
			font-weight: 300;
			}
			p {
			margin: 0;
			}
			.title {
			font-size: 16px;
			line-height: 20px;
			font-weight: 500;
			text-transform: uppercase;
			margin: 0;
			}
			.text {
			font-size: 14px;
			line-height: 18px;
			font-weight: 300;
			margin: 0;
			}
			.order-title {
			font-size: 14px;
			line-height: 18px;
			color: #8E8E8D;
			font-weight: 400;
			}
			.order-caption {
			font-size: 14px;
			line-height: 18px;
			font-weight: 500;
			text-transform: uppercase;
			}
			.social-title {
			font-size: 14px;
			line-height: 18px;
			}
			.social-link {
			text-decoration: none;
			color: #1D1D1B;
			}
			.footer-logo {
			font-weight: 500;
			font-size: 14px;
			line-height: 18px;
			text-transform: uppercase;
			}
			.footer-text {
			font-weight: 300;
			font-size: 14px;
			line-height: 18px;
			color: #8E8E8D;
			}
			.order-state {
			font-size: 14px;
			line-height: 18px;
			font-weight: 500;
			text-transform: uppercase;
			}
			.full-width-btn a {
				display: block !important;
			}
		</mj-style>
	</mj-head>
	<mj-body background-color="#FFF">
		<mj-section padding="0">
			<mj-column padding="12px 10px 16px" >
				<mj-table padding="0">
					<tr>
						<td>
							<img width="82px" src="../img/logo.png" align="left" />
						</td>
					</tr>
				</mj-table>
			</mj-column>
		</mj-section>
		<mj-section padding="0">
			<mj-column padding="0 10px 16px" >
				<mj-table padding="0">
					<tr>
						<td>
							<mj-text padding="0">
								<p class="title">Спасибо!</p>
								<p class="title">Ваш заказ в обработке</p>
							</mj-text>
						</td>
						<td width="48px">
							<img width="48px" src="../img/approved.png" align="left" />
						</td>
					</tr>
				</mj-table>
			</mj-column>
		</mj-section>
		<mj-section padding="0">
			<mj-column padding="0 10px 16px" >
				<mj-text padding="0">
					<p class="text">Здравствуйте, Александр! </p>
					<p class="text">Мы с вами связались и уточнили детали вашего заказа №1254. </p>
					<p class="text">После подтверждения мы подготовим его к отправке. </p>
				</mj-text>
			</mj-column>
		</mj-section>
		<mj-section padding="0">
			<mj-column padding="0 10px 16px" >
				<mj-table padding="0">
					<tr>
						<td width="50%">
							<mj-text padding="0">
								<p class="order-title">Номер заказа: </p>
								<p class="order-caption">№1254 </p>
							</mj-text>
						</td>
						<td width="50%">
							<mj-text padding="0">
								<p class="order-title">Статус: </p>
								<p class="order-state" style="color: #2A8A42;">Подтвержден </p>
							</mj-text>
						</td>
					</tr>
					<tr>
						<td colspan="2" style="padding-top: 4px;">
							<mj-text padding="0">
								<p class="order-title">Адрес доставки: </p>
								<p class="text">Пункт выдачи СДЭК<br/>г. Москва, ул. Тверская, 12</p>
							</mj-text>
						</td>
					</tr>
				</mj-table>
			</mj-column>
		</mj-section>
		<mj-section padding="0">
			<mj-column padding="0" >
				<mj-button css-class="full-width-btn" padding="10px" border-radius="0" href="#" width="100%" height="40px" background-color="#1D1D1B" font-size="14px">
					<span style="text-transform: uppercase;">Оплатить заказ</span>
				</mj-button>
			</mj-column>
		</mj-section>
		<mj-spacer height="10px" />
		<mj-section padding="0">
			<mj-column padding="16px 10px 16px" border-top="1px solid #E8E8E8">
				<mj-table padding="0" cellpadding="0" cellspacing="0" border="0" width="100%" >
					<tr>
						<td width="25%" align="center" valign="middle">
							<a href="#" class="social-link">
								<table  cellpadding="0" cellspacing="0" border="0" align="center" style="margin-left: 0;">
									<tr>
										<td valign="middle" style="padding-right:4px; line-height:0;">
											<img src="../img/telegram.png" width="14" height="14" alt="Telegram" border="0" style="display:block;" />
										</td>
										<td valign="middle">
											<p class="social-title" style="margin:0;">Telegram</p>
										</td>
									</tr>
								</table>
							</a>
						</td>
						<td width="25%" align="center" valign="middle">
							<a href="#" class="social-link">
								<table cellpadding="0" cellspacing="0" border="0" align="center" style="margin-left: 0;">
									<tr>
										<td valign="middle" style="padding-right:4px; line-height:0;">
											<img src="../img/youtube.png" width="14" height="14" alt="Youtube" border="0" style="display:block;" />
										</td>
										<td valign="middle">
											<p class="social-title" style="margin:0;">Youtube</p>
										</td>
									</tr>
								</table>
							</a>
						</td>
						<td width="25%" align="center" valign="middle">
							<a href="#" class="social-link">
								<table cellpadding="0" cellspacing="0" border="0" align="center" style="margin-left: 0;">
									<tr>
										<td valign="middle" style="padding-right:4px; line-height:0;">
											<img src="../img/pinterest.png" width="14" height="14" alt="Pinterest" border="0" style="display:block;" />
										</td>
										<td valign="middle">
											<p class="social-title" style="margin:0;">Pinterest</p>
										</td>
									</tr>
								</table>
							</a>
						</td>
						<td width="25%" align="center" valign="middle">
							<a href="#" class="social-link">
								<table cellpadding="0" cellspacing="0" border="0" align="center" style="margin-left: 0;">
									<tr>
										<td valign="middle" style="padding-right:4px; line-height:0;">
											<img src="../img/tiktok.png" width="14" height="14" alt="Tik-Tok" border="0" style="display:block;" />
										</td>
										<td valign="middle">
											<p class="social-title" style="margin:0;">Tik-Tok</p>
										</td>
									</tr>
								</table>
							</a>
						</td>
					</tr>
				</mj-table>
			</mj-column>
		</mj-section>
		<mj-section padding="0">
			<mj-column padding="0 10px 12px">
				<mj-text padding="0">
					<p class="footer-logo">IDOLIST</p>
					<mj-spacer height="42px" />
					<p class="footer-text">Благодарим за доверие!</p>
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>